{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AION 2 DPS Meter",
  "version": "3.0.7",
  "identifier": "de.maarloms.aion2-dps-meter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "A2Tools DPS Meter",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "resources": [
      "../src/data"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "wix": {
        "upgradeCode": "59F36FCA-6916-4275-B32F-C3E99B33AB02"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libpcap0.8t64 | libpcap0.8",
          "libcap2-bin"
        ],
        "postInstallScript": "../packaging/linux/postinst.sh"
      }
    }
  }
}
